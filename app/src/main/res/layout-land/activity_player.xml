<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yt_black">

    <!-- Full-screen player in landscape -->
    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/yt_black">

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- Same controls overlay - handled in Java code -->
        <RelativeLayout
            android:id="@+id/controlsOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000"
            android:visibility="gone">

            <!-- Top controls -->
            <LinearLayout
                android:id="@+id/topControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_revert"
                    android:tint="@color/yt_white"
                    android:scaleType="centerInside" />

                <TextView
                    android:id="@+id/txtPlayerTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/yt_white"
                    android:textSize="16sp"
                    android:layout_marginStart="8dp" />

                <ImageButton
                    android:id="@+id/btnAutoplay"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_popup_sync"
                    android:tint="@color/yt_white"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_manage"
                    android:tint="@color/yt_white"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/btnPip"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_crop"
                    android:tint="@color/yt_white"
                    android:scaleType="centerInside" />
            </LinearLayout>

            <!-- Center controls -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPrev"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_previous"
                    android:tint="@color/yt_white"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/btnRewind"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_rew"
                    android:tint="@color/yt_white"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_pause"
                    android:tint="@color/yt_white"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/btnForward"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_ff"
                    android:tint="@color/yt_white"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/btnNext"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_next"
                    android:tint="@color/yt_white"
                    android:scaleType="centerInside" />
            </LinearLayout>

            <!-- Bottom controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="vertical"
                android:padding="12dp">

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="3dp"
                    android:progressDrawable="@drawable/seekbar_progress"
                    android:thumb="@drawable/seekbar_thumb"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/txtCurrentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="@color/yt_white"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" / "
                        android:textColor="@color/yt_light_gray"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtTotalTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0:00"
                        android:textColor="@color/yt_light_gray"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnFullscreen"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_crop"
                        android:tint="@color/yt_white"
                        android:scaleType="centerInside" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <ProgressBar
            android:id="@+id/miniProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="bottom"
            android:progressDrawable="@drawable/seekbar_progress"
            android:max="100" />
    </FrameLayout>

    <!-- Hidden scrollview in landscape - not shown -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:id="@+id/txtVideoTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            <TextView android:id="@+id/txtVideoInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            <TextView android:id="@+id/txtChannelName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            <TextView android:id="@+id/txtSubscribers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            <TextView android:id="@+id/txtDescription" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            <TextView android:id="@+id/txtShowMore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            <TextView android:id="@+id/txtCommentCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            <TextView android:id="@+id/txtLikeCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            <LinearLayout android:id="@+id/btnLike" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            <LinearLayout android:id="@+id/btnShare" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            <LinearLayout android:id="@+id/btnDownload" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            <LinearLayout android:id="@+id/btnSave" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            <LinearLayout android:id="@+id/descriptionSection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            <Button android:id="@+id/btnSubscribe" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            <EditText android:id="@+id/edtComment" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            <ImageView android:id="@+id/imgPlayerChannelAvatar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            <LinearLayout android:id="@+id/commentsSection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerRelated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerComments" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
