<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <!-- Thumbnail Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp">

        <ImageView
            android:id="@+id/imgThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/yt_dark_card" />

        <!-- Duration Badge -->
        <TextView
            android:id="@+id/txtDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="@color/yt_overlay"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="@color/yt_white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Video Info Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Channel Avatar -->
        <ImageView
            android:id="@+id/imgChannelAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/circle_bg"
            android:src="@android:drawable/ic_menu_myplaces"
            android:tint="@color/yt_medium_gray"
            android:scaleType="centerInside" />

        <!-- Title & Meta -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/yt_white"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/txtMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/yt_medium_gray"
                android:textSize="12sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- More Options -->
        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_more"
            android:tint="@color/yt_light_gray"
            android:scaleType="centerInside"
            android:contentDescription="More" />
    </LinearLayout>
</LinearLayout>
